# ---------------------------------------------------------------------------
# ResumeIQ environment template. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Frontend (Vite exposes only VITE_* to the browser) ---------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:8000

# --- Supabase (server only) -------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-from-project-settings
# Optional: only needed if you verify tokens with the legacy HS256 secret
# instead of the project's JWKS endpoint.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated

# --- Database / queue -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0

# --- AI provider (any OpenAI-compatible endpoint) ---------------------------
# Leave AI_PROVIDER_API_KEY empty to run the deterministic offline provider.
AI_PROVIDER=auto
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER_API_KEY=

# --- Payments ---------------------------------------------------------------
# mock = fully functional locally, no network. stripe = real Checkout + webhooks.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App --------------------------------------------------------------------
ENVIRONMENT=local
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
CELERY_EAGER=false
OCR_ENABLED=true
